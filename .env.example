# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Email сервисного аккаунта Google Cloud (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Приватный ключ сервисного аккаунта (из JSON-файла ключа), переносы строк как \n
GOOGLE_PRIVATE_KEY=""

# Альтернатива для локального JSON-файла ключа сервисного аккаунта
GOOGLE_APPLICATION_CREDENTIALS=

# ID таблицы Google Sheets (из URL таблицы)
SPREADSHEET_ID=

# Произвольная секретная строка для защиты webhook-эндпоинта
WEBHOOK_SECRET=changeme

# Публичный URL задеплоенного проекта на Vercel (без слэша на конце), нужен только для scripts/setWebhook.js
PUBLIC_URL=https://your-app.vercel.app
